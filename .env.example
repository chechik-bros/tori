# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the daily reminder job. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL for links in messages (cancel links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Cloud API (Meta) — see docs/whatsapp.md
WA_PHONE_NUMBER_ID=
WA_TOKEN=
WA_TEMPLATE_NAME=appointment_reminder

# Random string. Vercel sends it to the cron route so strangers can't trigger it.
CRON_SECRET=
